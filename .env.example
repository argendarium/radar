# Copia este archivo a .env y completa las llaves

# Base de datos: SQLite hoy. Para Postgres: postgresql+psycopg://user:pass@host:5432/radar
DATABASE_URL=

# Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN=
META_ACTOR_ID=apify/facebook-ads-scraper
META_COUNTRIES=DO,MX,CO
META_KEYWORDS=pago contra entrega,envio gratis,paga al recibir
META_RESULTS_LIMIT=100
# Tope de gasto por ejecución de actor (USD)
APIFY_MAX_CHARGE_USD=2

# TikTok Creative Center (opcional). Elige un actor en Apify Store y configura config/tiktok_input.json
TIKTOK_ACTOR_ID=

# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
MAX_NORMALIZE_PER_RUN=40

# Negocio: tasa USD a DOP para calcular margen (actualizar)
USD_TO_DOP=60

# Pesos del score (suman 1.0)
W_LONGEVITY=0.35
W_COPIES=0.25
W_INTENSITY=0.20
W_VIABILITY=0.20

# Alertas (opcional): bot de @BotFather y tu chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analizador de producto (opcional): números externos para un candidato, on-demand
# RapidAPI "Real-Time Amazon Data" (tier gratis: 100 requests/mes): https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-amazon-data
RAPIDAPI_KEY=
# AliExpress Affiliate API (gratis, aprobación en portals.aliexpress.com)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Actor de Apify para Alibaba (elige uno en Apify Store, ej. dami_studio/alibaba-com-scraper)
ALIBABA_APIFY_ACTOR_ID=
ALIBABA_MAX_CHARGE_USD=0.05
